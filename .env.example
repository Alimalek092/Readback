# =========================================================================
# ReadBack SaaS — Environment Configuration
# =========================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication Cookie Secret (Optional salt for session tokens)
SESSION_SECRET=super_secret_session_encryption_key_change_in_production

# Relational Database (Optional: Connect managed Supabase PostgreSQL)
# If left blank, ReadBack operates in zero-dependency local relational mode
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payment Gateway: Stripe (Optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Payment Gateway: Polar (Alternative)
POLAR_API_KEY=
POLAR_WEBHOOK_SECRET=

# External Book Metadata (Open Library does not require an API key)
OPEN_LIBRARY_API_TIMEOUT_MS=6000
